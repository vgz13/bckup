{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BCKUP",
  "version": "1.0.0",
  "identifier": "local.bckup.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BCKUP",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "panel",
        "title": "BCKUP",
        "url": "panel.html",
        "width": 380,
        "height": 520,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "BCKUP",
    "category": "Photography",
    "shortDescription": "Verified camera card offloads",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["resources/*"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
